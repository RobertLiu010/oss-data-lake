# Vector Lake 环境变量模板
# ================================
# 复制为 .env 并修改为实际值
# cp .env.example .env

# ---- 服务端口 ----
VL_PORT=8000

# ---- 存储后端 ----
# 可选: local | s3
VL_STORAGE_BACKEND=local

# ---- 本地存储 ----
VL_DATA_DIR=./data
VL_LANCE_DIR=./lance_data

# ---- S3/MinIO 存储 (VL_STORAGE_BACKEND=s3 时生效) ----
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vector-lake
S3_PREFIX=data
S3_REGION=us-east-1

# ---- MinIO (docker compose --profile minio) ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Embedding 服务 ----
VL_EMBEDDING_BASE_URL=http://127.0.0.1:8006
VL_EMBEDDING_MODEL=embedding-v5
VL_EMBEDDING_MOCK=1

# ---- 可观测性 ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ---- 安全 ----
AUTH_ENABLED=false
